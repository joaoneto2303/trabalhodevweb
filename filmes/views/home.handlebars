<div class="p-4 mb-4 bg-white rounded-3 shadow-sm">
  <h1 class="fw-bold">Catálogo Cinematográfico</h1>
  <p class="text-secondary mb-3">Gerencie filmes, artistas, diretores e fichas técnicas.</p>
  
  {{#if msg}}
    <div class="alert alert-{{tipo}} mb-0" role="alert">
      {{msg}}
    </div>
  {{else}}
    <div class="alert alert-info mb-0" role="alert">
      Bem-vindo! Comece cadastrando um <a href="/diretores/cadastrar" class="alert-link">diretor</a> e um
      <a href="/artistas/cadastrar" class="alert-link">artista</a>, depois cadastre o
      <a href="/filmes/cadastrar" class="alert-link">filme</a>.
    </div>
  {{/if}}
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <a href="/filmes" class="text-decoration-none"><span class="badge text-bg-primary fs-6">Filmes: {{contadores.filmes}}</span></a>
  <a href="/artistas" class="text-decoration-none"><span class="badge text-bg-success fs-6">Artistas: {{contadores.artistas}}</span></a>
  <a href="/diretores" class="text-decoration-none"><span class="badge text-bg-warning fs-6">Diretores: {{contadores.diretores}}</span></a>
  <a href="/fichas" class="text-decoration-none"><span class="badge text-bg-secondary fs-6">Fichas: {{contadores.fichas}}</span></a>
</div>

<h2 class="h4 mb-3">Filmes em destaque</h2>
<div class="row g-3">
  {{#each destaques}}
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title h5">{{titulo}}</h3>
          <p class="mb-2">
            <span class="badge text-bg-info">{{genero}}</span>
            <span class="badge text-bg-secondary">{{ano}}</span>
          </p>
          <p class="card-text text-secondary small">{{sinopse}}</p>
        </div>
        <div class="card-footer bg-white border-0">
          <a href="/filmes/{{id}}" class="text-decoration-none fw-semibold">Ver detalhes &rarr;</a>
        </div>
      </div>
    </div>
  {{else}}
    <div class="col-12"><div class="alert alert-warning mb-0">Nenhum filme cadastrado ainda.</div></div>
  {{/each}}
</div>