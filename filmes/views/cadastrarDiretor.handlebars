{{!-- views/cadastrarDiretor.handlebars --}}
<h1 class="h3 mb-3">Cadastrar diretor</h1>
<form action="/diretores/cadastrar" method="POST" class="bg-white p-4 rounded-3 shadow-sm">
  <div class="mb-3">
    <label class="form-label" for="nome">Nome</label>
    <input class="form-control" type="text" id="nome" name="nome" required>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label" for="nacionalidade">Nacionalidade</label>
      <input class="form-control" type="text" id="nacionalidade" name="nacionalidade">
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label" for="dataNascimento">Data de nascimento</label>
      <input class="form-control" type="date" id="dataNascimento" name="dataNascimento">
    </div>
  </div>
  <input type="submit" value="Salvar diretor" class="bg-success text-white border-0 rounded px-4 py-2">
  <a href="/diretores" class="text-secondary ms-3">Cancelar</a>
</form>
