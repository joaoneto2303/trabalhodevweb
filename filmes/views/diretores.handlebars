{{!-- views/diretores.handlebars : listagem em TABLE --}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Diretores <span class="badge text-bg-warning">{{diretores.length}}</span></h1>
  <a href="/diretores/cadastrar" class="text-decoration-none bg-primary text-white rounded px-3 py-2">+ Novo diretor</a>
</div>

{{#if diretores.length}}
<div class="table-responsive">
  <table class="table table-hover table-striped align-middle bg-white">
    <thead class="table-dark">
      <tr><th>Nome</th><th>Nacionalidade</th><th>Nascimento</th><th>Filmes</th><th></th></tr>
    </thead>
    <tbody>
      {{#each diretores}}
      <tr>
        <td>{{nome}}</td>
        <td>{{nacionalidade}}</td>
        <td>{{data dataNascimento}}</td>
        <td><span class="badge text-bg-primary">{{Filmes.length}}</span></td>
        <td><a href="/diretores/{{id}}" class="text-decoration-none">Detalhar</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  <div class="alert alert-warning">Nenhum diretor cadastrado.</div>
{{/if}}
