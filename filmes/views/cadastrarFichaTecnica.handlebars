{{!-- views/cadastrarFichaTecnica.handlebars --}}
<h1 class="h3 mb-3">Cadastrar ficha técnica</h1>

{{#unless filmes.length}}
  <div class="alert alert-warning">Cadastre um <a href="/filmes/cadastrar" class="alert-link">filme</a> primeiro.</div>
{{/unless}}

<form action="/fichas/cadastrar" method="POST" class="bg-white p-4 rounded-3 shadow-sm">
  <div class="mb-3">
    <label class="form-label" for="filmeId">Filme</label>
    <select class="form-select" id="filmeId" name="filmeId" required>
      <option value="">Selecione...</option>
      {{#each filmes}}<option value="{{id}}">{{titulo}} ({{ano}})</option>{{/each}}
    </select>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label" for="roteiro">Roteiro</label>
      <input class="form-control" type="text" id="roteiro" name="roteiro">
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label" for="produtora">Produtora</label>
      <input class="form-control" type="text" id="produtora" name="produtora">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label" for="idioma">Idioma</label>
      <input class="form-control" type="text" id="idioma" name="idioma">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label" for="paisOrigem">País de origem</label>
      <input class="form-control" type="text" id="paisOrigem" name="paisOrigem">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label" for="classificacao">Classificação</label>
      <select class="form-select" id="classificacao" name="classificacao">
        <option>Livre</option><option>10</option><option>12</option><option>14</option><option>16</option><option>18</option>
      </select>
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label" for="orcamento">Orçamento (US$ mi)</label>
      <input class="form-control" type="number" step="0.01" id="orcamento" name="orcamento">
    </div>
  </div>
  <input type="submit" value="Salvar ficha" class="bg-success text-white border-0 rounded px-4 py-2">
  <a href="/fichas" class="text-secondary ms-3">Cancelar</a>
</form>
