{{!-- views/artistas.handlebars : listagem em TABLE --}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Artistas <span class="badge text-bg-success">{{artistas.length}}</span></h1>
  <a href="/artistas/cadastrar" class="text-decoration-none bg-primary text-white rounded px-3 py-2">+ Novo artista</a>
</div>

{{#if artistas.length}}
<div class="table-responsive">
  <table class="table table-hover table-striped align-middle bg-white">
    <thead class="table-dark">
      <tr><th>Nome</th><th>Nacionalidade</th><th>Nascimento</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      {{#each artistas}}
      <tr>
        <td>{{nome}}</td>
        <td>{{nacionalidade}}</td>
        <td>{{data dataNascimento}}</td>
        <td><span class="badge text-bg-{{corStatus status}}">{{status}}</span></td>
        <td><a href="/artistas/{{id}}" class="text-decoration-none">Detalhar</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  <div class="alert alert-warning">Nenhum artista cadastrado.</div>
{{/if}}
